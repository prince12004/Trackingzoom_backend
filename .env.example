# ---- Server ----
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000/admin

# ---- Seed admin (development only) ----
SEED_ADMIN_EMAIL=admin@trackingzoom.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_local_password

# ---- Database ----
MONGODB_URI=mongodb://127.0.0.1:27017/trackingzoom

# ---- JWT ----
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Cookies ----
COOKIE_DOMAIN=localhost

# ---- OTP / SMS (MSG91 recommended) ----
# Get from https://control.msg91.com/app/dashboard -> API Keys
SMS_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=TrackingZoom GPS
SMTP_FROM_EMAIL=no-reply@trackingzoom.com

# ---- Cloudinary ----
# Get from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
# Get from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Admin 2FA ----
TOTP_ISSUER=TrackingZoom Admin

# ---- Analytics (optional, surfaced to frontend via /api/v1/settings) ----
GA4_MEASUREMENT_ID=
META_PIXEL_ID=
GOOGLE_ADS_CONVERSION_ID=

# ---- Sentry (optional) ----
SENTRY_DSN=

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
